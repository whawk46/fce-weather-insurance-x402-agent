# Coston2 (flareTestnet, chain id 114)
NEXT_PUBLIC_CHAIN_ID=114
NEXT_PUBLIC_RPC_URL=https://coston2-api.flare.network/ext/C/rpc

# From config/extension.env after pre-build.sh (synced by scripts/sync-env.sh)
NEXT_PUBLIC_WEATHER_INSURANCE=0x32e5C99DEa13a0D3a40969f85389f71c7787BB18
NEXT_PUBLIC_PAY_TOKEN=0x53192e788991AD96bC180249B15AefB94E597dD1

# Extension proxy — used by Next.js API routes (server-side only).
# Local stack: http://127.0.0.1:6674 (docker maps host 6674 → proxy 6664).
# Coston2 on-chain + remote TEE: ngrok https URL from `ngrok http 6674`.
EXT_PROXY_URL=http://127.0.0.1:6674

# Optional fallback when EXT_PROXY_URL is stale (e.g. dead ngrok). Tried after primary fails.
EXT_PROXY_LOCAL_URL=http://127.0.0.1:6674

# Instruction fee forwarded to TEE registry (matches tools DefaultFee = 1e12 wei)
NEXT_PUBLIC_INSTRUCTION_FEE_WEI=1000000000000

# Base URL of the x402 payment gateway (tools/cmd/x402-gateway). getWeather/
# requestSettlement are onlyGateway, so the frontend must go through this. It
# returns the current on-chain feeToken/amount in its 402 response.
NEXT_PUBLIC_X402_GATEWAY_URL=http://localhost:7703

# Server-side geocoding for buy policy (City,CC → lat/lon). Same key as repo .env / TEE.
# Omit this line to inherit from frontend/.env — do not leave OPENWEATHERMAP_API_KEY= empty.
# OPENWEATHERMAP_API_KEY=

# AI insurance agent (in-app chat). Required for /api/chat.
OPENAI_API_KEY=sk-...
# Optional model override (default: gpt-4.1-mini)
# AI_MODEL=gpt-4.1-mini
