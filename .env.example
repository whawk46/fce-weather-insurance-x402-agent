# weather-insurance — environment template
#
# Copy to .env.coston2 / .env.local.coston2 (etc.) and switch with:
#   ./scripts/use-chain.sh coston2
#   ./scripts/use-chain.sh local coston2

# --- Keys -------------------------------------------------------------------
DEPLOYMENT_PRIVATE_KEY="<your-funded-private-key-hex-no-0x>"
INITIAL_OWNER="0x<your-address>"
PROXY_PRIVATE_KEY="983760a4ebf75b2ac3a93531168a0f225d01e5dc6e3568adbd46233ba1fb4fa4"

# --- Chain ------------------------------------------------------------------
CHAIN=coston2
CHAIN_URL=https://coston2-api.flare.network/ext/C/rpc
ADDRESSES_FILE=./config/coston2/deployed-addresses.json
LOCAL_MODE=false
SIMULATED_TEE=false

# --- Proxies ----------------------------------------------------------------
NORMAL_PROXY_URL=https://tee-proxy-coston2-1.flare.rocks
# Deployed: devops proxy URL. Local simulated: your ngrok https URL (ngrok http 6674).
EXT_PROXY_URL=

# --- Weather extension ------------------------------------------------------
# Required before start-services.sh — TEE rejects FETCH/SETTLE without this.
OPENWEATHERMAP_API_KEY=

# Coston2 WPT pay token for premiums/payouts (extension-setup.sh calls setPayToken).
PAY_TOKEN=0x53192e788991AD96bC180249B15AefB94E597dD1

# --- x402 gateway + on-chain fee ---------------------------------------------
# getWeather/requestSettlement are onlyGateway (only GATEWAY_ADDRESS may call
# them) and pull the fee atomically via transferFrom from the payer the
# gateway names — enforced by the contract itself, not by the HTTP layer in
# front of it. Set via extension-setup.sh -> setGateway/setFeeToken/
# setFeeRecipient/setFetchFee/setSettleFee.

# Address allowed to call getWeather/requestSettlement. Defaults to the
# deployer's own address (DEPLOYMENT_PRIVATE_KEY) if unset.
GATEWAY_ADDRESS=

# Any ERC-20 works (e.g. FXRP via AssetManagerFXRP.fAsset() — see the
# flare-fassets skill — or a plain test token like USDT0). Do not guess the
# address; verify it on-chain first.
FEE_TOKEN=
# Wallet fees are sent to.
FEE_RECIPIENT=
# Fee amounts in the feeToken's base units — check its decimals() first.
# 1 = the smallest possible non-zero charge. Leave at 0/unset to disable a fee
# (see _collectFee's zero-amount no-op).
FETCH_FEE=1
SETTLE_FEE=1

# Next.js x402 gateway (reuses DEPLOYMENT_PRIVATE_KEY as its wallet).
# Optional CORS for external callers of /x402/weather/* (same-origin dApp does not need it).
CORS_ORIGIN=http://localhost:3000

# --- Docker -----------------------------------------------------------------
# REGISTRY=registry.gitlab.com/flarenetwork/tee/e2e
